# Prisma resolves this path relative to prisma/schema.prisma, so ../data
# points at the project-root data/ directory.
DATABASE_URL="file:../data/db.sqlite"

# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Only read once, by the seed script, to create the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

GAMES_STORAGE_PATH=./data/games
THUMBNAILS_STORAGE_PATH=./data/uploads/thumbnails
MAX_UPLOAD_SIZE_MB=15
FEATURE_RATINGS_ENABLED=true

# Optional: set once game content moves to its own subdomain
# GAMES_BASE_URL=
